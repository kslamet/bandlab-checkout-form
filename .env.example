# Copy to .env and fill in. Never commit .env.

# --- API keys (placeholders) ---
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME

# --- Catalog ---
# Price for "annual subscription product" (USD 120 / year) created in Bob.
# Product: prod_VHAs0qszs0RN7R
PRICE_ID=price_1UGcWsGo5snFNHkBC1ocP4Cr

# --- Promotion codes (the customer-facing strings, not the promo_... IDs) ---
# applyPromotionCode() takes the code string.
DEFAULT_PROMOTION_CODE=20OFF
ALTERNATE_PROMOTION_CODE=25OFF

# --- App ---
PORT=4242
# Leave APP_URL unset on Vercel so each deployment derives its own origin from the
# request headers. Set it only for local development if you need a fixed value.
APP_URL=http://localhost:4242

# --- Stripe API version ---
# Optional override. The app pins 2026-03-25.dahlia in code, which is the minimum
# for ui_mode "form". Leaving this blank is correct: the account default is NOT
# used, because an older default fails at loadActions() with
#   Invalid ui_mode: form. In order to use ui_mode: form, you must upgrade to
#   Stripe API version 2026-03-25.dahlia.
# Set this only to move to a later Dahlia release, for example 2026-08-26.dahlia.
STRIPE_API_VERSION=
